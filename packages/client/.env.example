# Zrzur local development — never point these at stoat.chat / revolt.chat
VITE_HOST=localhost
VITE_API_URL=http://127.0.0.1:14702

# Dev server overrides (applies to default instance)
# VITE_DEV_WS_URL=ws://127.0.0.1:14703
# VITE_DEV_MEDIA_URL=http://127.0.0.1:14704
# VITE_DEV_PROXY_URL=http://127.0.0.1:14705
# VITE_DEV_GIFBOX_URL=http://127.0.0.1:14706

# Optional Zrzur-owned services (off when unset, fail closed, no upstream)
# VITE_EMOJI_CDN=https://cdn.zrzur.com/emoji
# VITE_GEO_URL=

# Home page links (hidden while unset; upstream Stoat/Revolt hosts are rejected)
# Support / donation page, full http(s) link:
# VITE_SUPPORT_URL=
# Invite code of the official Zrzur community server (code only, not a URL):
# VITE_COMMUNITY_INVITE=

# Standalone Designs site: the same build, opened on this host, shows Designs
# only (no chat around it). Unset: Designs is a page inside the app only.
# The API must allow this origin (CORS) before it can be used.
# VITE_DESIGNS_HOST=designs.zrzur.com
# Standalone developer documentation site (unset: the docs stay at /developers/docs in the app)
# VITE_DOCS_URL=https://developers.zrzur.com

# Release channel: "beta" shows a quiet "Beta" label by the logo and in the
# version line. A local build without it counts as beta; the container
# (docker/inject.js) writes "stable" when it is not set.
# VITE_RELEASE_CHANNEL=beta

# Production builds REQUIRE VITE_HOST and VITE_API_URL (fail closed).
# Planned production (owner DNS required before use):
# VITE_HOST=app.zrzur.com
# VITE_API_URL=https://api.zrzur.com

# specify Sentry DSN
VITE_SENTRY_DSN=
VITE_SENTRY_TUNNEL=

# Short invite/share domain (optional). Example: https://zrzur.cc
# When set, CreateInvite links use https://zrzur.cc/{code}
#VITE_INVITE_ORIGIN=https://zrzur.cc
